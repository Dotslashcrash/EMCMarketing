{
  "routes": [
    {
      "route": "/brand-portal/*",
      "redirect": "/contact/",
      "statusCode": 301
    },
    {
      "route": "/admin/*",
      "redirect": "/contact/",
      "statusCode": 301
    }
  ],
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [
      "/_next/*",
      "/api/*",
      "/images/*",
      "/js/*",
      "/robots.txt",
      "/sitemap.xml"
    ]
  },
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "Referrer-Policy": "strict-origin-when-cross-origin"
  },
  "platform": {
    "apiRuntime": "node:22"
  }
}
